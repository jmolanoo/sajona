# Variables de entorno para SAJONA PWA (copiar a .env y asignar secretos reales)
APP_NAME=SAJONA API
APP_VERSION=1.0.0
ENVIRONMENT=production

POSTGRES_DB=sajona
POSTGRES_USER=sajona
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

DATABASE_URL=postgresql+asyncpg://sajona:REPLACE_WITH_STRONG_PASSWORD@sajona-db:5432/sajona
JWT_SECRET_KEY=REPLACE_WITH_MIN_32_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
AUDIT_LOG_DIR=/app/audit_logs
SEED_DEMO_DATA=true
CORS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
